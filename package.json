{
	"name": "n8n-nodes-paymob",
	"version": "0.1.0",
	"description": "n8n community node for Paymob Accept: payment intentions, refunds, voids, transaction lookup, and HMAC-verified transaction callbacks.",
	"license": "MIT",
	"homepage": "https://github.com/MaeenAlganimi/n8n-nodes-paymob",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"paymob",
		"payments"
	],
	"author": {
		"name": "Maeen Alganimi",
		"email": "182806620+MaeenAlganimi@users.noreply.github.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MaeenAlganimi/n8n-nodes-paymob.git"
	},
	"bugs": {
		"url": "https://github.com/MaeenAlganimi/n8n-nodes-paymob/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --import tsx --test tests/*.test.ts"
	},
	"files": [
		"dist",
		"examples"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PaymobApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Paymob/Paymob.node.js",
			"dist/nodes/PaymobTrigger/PaymobTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.52.4",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"tsx": "4.23.15",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
