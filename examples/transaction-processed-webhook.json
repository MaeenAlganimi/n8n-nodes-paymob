				"width": 400
			},
			"id": "6c3e4f32-8d60-4b3c-9e5f-3c4d5e6f7001",
			"name": "Note",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [-20, -260]
		},
		{
			"parameters": {
				"events": "success",
				"path": "paymob"
			},
			"id": "6c3e4f32-8d60-4b3c-9e5f-3c4d5e6f7002",
			"name": "Paymob transaction callback",
			"type": "n8n-nodes-paymob.paymobTrigger",
			"typeVersion": 1,
			"position": [0, 0],
			"credentials": {
				"paymobApi": {
					"id": "replace-with-your-credential",
					"name": "Paymob account"
				}
			}
		},
