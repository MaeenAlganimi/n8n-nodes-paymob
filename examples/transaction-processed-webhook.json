							"value": "={{ $json.orderId }}",
							"type": "number"
						},
						{
							"id": "amount",
							"name": "amountCents",
							"value": "={{ $json.amountCents }}",
							"type": "number"
						},
						{
							"id": "paid",
							"name": "success",
							"value": "={{ $json.success }}",
							"type": "boolean"
						}
					]
				},
				"options": {}
			},
			"id": "6c3e4f32-8d60-4b3c-9e5f-3c4d5e6f7003",
			"name": "Keep transaction summary",
			"type": "n8n-nodes-base.set",
